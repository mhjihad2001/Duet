# GEMINI_API_KEY: Not used by Duet.
# GEMINI_API_KEY=MY_GEMINI_API_KEY

# PUSH_WEBHOOK_URL: Optional Cloudflare Worker or Google Apps Script URL
# used to relay encrypted FCM data payloads on the free Firebase Spark plan.
PUSH_WEBHOOK_URL=https://example.invalid/duet-push-webhook

# GITHUB_REPO: Your GitHub repository (owner/repo) for in-app update checks.
GITHUB_REPO=your-username/duet-messenger
