rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net: deny all reads and writes by default
    match /{document=**} {
      allow read, write: if false;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Strict 2-User Whitelist Gate:
    // To statically lock this database to two exact Firebase Auth UIDs, replace the list below:
    //   let allowedUids = ['USER_1_UID', 'USER_2_UID'];
    //   return isSignedIn() && request.auth.uid in allowedUids;
    // By default, empty list enforces strict 2-seat couple room membership (memberUids.size() <= 2).
    function isWhitelistedUser() {
      let allowedUids = [];
      return isSignedIn() && (allowedUids.size() == 0 || request.auth.uid in allowedUids);
    }

    function isValidMemberList(members) {
      return members is list &&
             members.size() >= 1 &&
             members.size() <= 2 &&
             members[0] is string &&
             (members.size() == 1 || (members[1] is string && members[1] != members[0]));
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             (!('roomId' in data) || (data.roomId is string && data.roomId.size() <= 128)) &&
             (!('partnerUid' in data) || (data.partnerUid is string && data.partnerUid.size() <= 128)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidRoom(data) {
      return data.creatorUid is string && data.creatorUid.size() > 0 && data.creatorUid.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.inviteCodeHash is string && data.inviteCodeHash.size() >= 16 && data.inviteCodeHash.size() <= 128 &&
             data.disappearingSeconds is int && data.disappearingSeconds in [0, 60, 3600, 86400] &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidPresence(data) {
      return data.userId is string && data.userId.size() > 0 && data.userId.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 80 &&
             data.online is bool &&
             data.typing is bool &&
             data.recordingAudio is bool &&
             (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512)) &&
             data.lastSeenAt is timestamp && data.lastSeenAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidMessage(data) {
      return data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.messageType is string && data.messageType in ['TEXT', 'IMAGE', 'VOICE', 'FILE_P2P'] &&
             data.encryptedPayload is string && data.encryptedPayload.size() > 0 && data.encryptedPayload.size() <= 400000 &&
             (!('replyToMessageId' in data) || (data.replyToMessageId is string && data.replyToMessageId.size() <= 128)) &&
             (!('encryptedReplyPreview' in data) || (data.encryptedReplyPreview is string && data.encryptedReplyPreview.size() <= 4096)) &&
             data.status is string && data.status in ['SENT', 'DELIVERED', 'READ'] &&
             (!('reactionJson' in data) || (data.reactionJson is string && data.reactionJson.size() <= 512)) &&
             data.deletedForEveryone is bool &&
             data.expiresAtMillis is int && data.expiresAtMillis >= 0 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCall(data) {
      return data.callerUid is string && data.callerUid.size() > 0 && data.callerUid.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.callType is string && data.callType in ['AUDIO', 'VIDEO'] &&
             data.status is string && data.status in ['RINGING', 'ACTIVE', 'ENDED', 'DECLINED'] &&
             (!('encryptedOffer' in data) || (data.encryptedOffer is string && data.encryptedOffer.size() <= 32768)) &&
             (!('encryptedAnswer' in data) || (data.encryptedAnswer is string && data.encryptedAnswer.size() <= 32768)) &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidCandidate(data) {
      return data.senderUid is string && data.senderUid.size() > 0 && data.senderUid.size() <= 128 &&
             isValidMemberList(data.memberUids) &&
             data.encryptedCandidate is string && data.encryptedCandidate.size() > 0 && data.encryptedCandidate.size() <= 8192 &&
             data.createdAt is timestamp && data.createdAt <= request.time;
    }

    // Private User Profile: strictly owner-only access
    match /users/{userId} {
      allow get: if isWhitelistedUser() && isValidId(userId) && request.auth.uid == userId;
      allow list: if false;
      allow create: if isWhitelistedUser() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == request.auth.uid &&
                       incoming().keys().hasAll(['userId', 'displayName', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'displayName', 'fcmToken', 'roomId', 'partnerUid', 'createdAt', 'updatedAt']) &&
                       isValidUserProfile(incoming());
      allow update: if isWhitelistedUser() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'fcmToken', 'roomId', 'partnerUid', 'updatedAt']);
      allow delete: if isWhitelistedUser() && isValidId(userId) && request.auth.uid == userId;
    }

    // Private 2-Person Couple Room
    match /rooms/{roomId} {
      // Allow get for active members, or for a second partner holding the exact secret roomId while seat 2 is still open
      allow get: if isWhitelistedUser() &&
                    isValidId(roomId) &&
                    (request.auth.uid in existing().memberUids || existing().memberUids.size() == 1);
      allow list: if isWhitelistedUser() && request.auth.uid in existing().memberUids;

      allow create: if isWhitelistedUser() &&
                       isValidId(roomId) &&
                       incoming().creatorUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       incoming().keys().hasAll(['creatorUid', 'memberUids', 'inviteCodeHash', 'disappearingSeconds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['creatorUid', 'memberUids', 'inviteCodeHash', 'disappearingSeconds', 'createdAt', 'updatedAt']) &&
                       isValidRoom(incoming());

      allow update: if isWhitelistedUser() &&
                       isValidId(roomId) &&
                       isValidRoom(incoming()) &&
                       incoming().creatorUid == existing().creatorUid &&
                       incoming().inviteCodeHash == existing().inviteCodeHash &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         // Action 1: Partner joins open 2nd seat
                         (
                           existing().memberUids.size() == 1 &&
                           !(request.auth.uid in existing().memberUids) &&
                           incoming().memberUids.size() == 2 &&
                           existing().memberUids[0] in incoming().memberUids &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt'])
                         ) ||
                         // Action 2: Member updates disappearing message timer
                         (
                           request.auth.uid in existing().memberUids &&
                           incoming().memberUids == existing().memberUids &&
                           incoming().diff(existing()).affectedKeys().hasOnly(['disappearingSeconds', 'updatedAt'])
                         )
                       );

      allow delete: if isWhitelistedUser() && isValidId(roomId) && request.auth.uid in existing().memberUids;

      // Presence Subcollection (denormalized memberUids for flat evaluation)
      match /presence/{userId} {
        allow get: if isWhitelistedUser() && isValidId(roomId) && isValidId(userId) && request.auth.uid in existing().memberUids;
        allow list: if isWhitelistedUser() && request.auth.uid in existing().memberUids;
        allow create: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         incoming().userId == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['userId', 'memberUids', 'displayName', 'online', 'typing', 'recordingAudio', 'lastSeenAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'memberUids', 'displayName', 'online', 'typing', 'recordingAudio', 'fcmToken', 'lastSeenAt', 'updatedAt']) &&
                         isValidPresence(incoming());
        allow update: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(userId) &&
                         request.auth.uid == userId &&
                         request.auth.uid in existing().memberUids &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().userId == existing().userId &&
                         isValidPresence(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'displayName', 'online', 'typing', 'recordingAudio', 'fcmToken', 'lastSeenAt', 'updatedAt']);
        allow delete: if isWhitelistedUser() && isValidId(roomId) && isValidId(userId) && request.auth.uid == userId;
      }

      // Encrypted Messages Subcollection (denormalized memberUids for flat evaluation)
      match /messages/{messageId} {
        allow get: if isWhitelistedUser() && isValidId(roomId) && isValidId(messageId) && request.auth.uid in existing().memberUids;
        allow list: if isWhitelistedUser() && request.auth.uid in existing().memberUids;
        allow create: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         incoming().senderUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['senderUid', 'memberUids', 'messageType', 'encryptedPayload', 'status', 'deletedForEveryone', 'expiresAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['senderUid', 'memberUids', 'messageType', 'encryptedPayload', 'replyToMessageId', 'encryptedReplyPreview', 'status', 'reactionJson', 'deletedForEveryone', 'expiresAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidMessage(incoming());
        allow update: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(messageId) &&
                         request.auth.uid in existing().memberUids &&
                         incoming().senderUid == existing().senderUid &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().createdAt == existing().createdAt &&
                         isValidMessage(incoming()) &&
                         (
                           // Sender can delete for everyone, update reactions, or mark read/delivered
                           (
                             request.auth.uid == existing().senderUid &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['encryptedPayload', 'deletedForEveryone', 'status', 'reactionJson', 'updatedAt'])
                           ) ||
                           // Partner can update delivery/read receipts and reactions, never alter payload
                           (
                             request.auth.uid != existing().senderUid &&
                             incoming().diff(existing()).affectedKeys().hasOnly(['status', 'reactionJson', 'updatedAt'])
                           )
                         );
        allow delete: if isWhitelistedUser() && isValidId(roomId) && isValidId(messageId) && request.auth.uid in existing().memberUids;
      }

      // Encrypted WebRTC Call Signaling
      match /calls/{callId} {
        allow get: if isWhitelistedUser() && isValidId(roomId) && isValidId(callId) && request.auth.uid in existing().memberUids;
        allow list: if isWhitelistedUser() && request.auth.uid in existing().memberUids;
        allow create: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(callId) &&
                         incoming().callerUid == request.auth.uid &&
                         request.auth.uid in incoming().memberUids &&
                         incoming().keys().hasAll(['callerUid', 'memberUids', 'callType', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['callerUid', 'memberUids', 'callType', 'status', 'encryptedOffer', 'encryptedAnswer', 'createdAt', 'updatedAt']) &&
                         isValidCall(incoming());
        allow update: if isWhitelistedUser() &&
                         isValidId(roomId) &&
                         isValidId(callId) &&
                         request.auth.uid in existing().memberUids &&
                         incoming().callerUid == existing().callerUid &&
                         incoming().memberUids == existing().memberUids &&
                         incoming().createdAt == existing().createdAt &&
                         isValidCall(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'encryptedOffer', 'encryptedAnswer', 'updatedAt']);
        allow delete: if isWhitelistedUser() && isValidId(roomId) && isValidId(callId) && request.auth.uid in existing().memberUids;

        match /candidates/{candidateId} {
          allow get: if isWhitelistedUser() && isValidId(roomId) && isValidId(callId) && isValidId(candidateId) && request.auth.uid in existing().memberUids;
          allow list: if isWhitelistedUser() && request.auth.uid in existing().memberUids;
          allow create: if isWhitelistedUser() &&
                           isValidId(roomId) &&
                           isValidId(callId) &&
                           isValidId(candidateId) &&
                           incoming().senderUid == request.auth.uid &&
                           request.auth.uid in incoming().memberUids &&
                           incoming().keys().hasAll(['senderUid', 'memberUids', 'encryptedCandidate', 'createdAt']) &&
                           incoming().keys().hasOnly(['senderUid', 'memberUids', 'encryptedCandidate', 'createdAt']) &&
                           isValidCandidate(incoming());
          allow update: if false;
          allow delete: if isWhitelistedUser() && isValidId(roomId) && isValidId(callId) && isValidId(candidateId) && request.auth.uid in existing().memberUids;
        }
      }
    }
  }
}
